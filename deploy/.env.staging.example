# Staging environment: same compose file, run as project "karyakita-staging".
#   cp deploy/.env.staging.example .env.staging && chmod 600 .env.staging      (backend repo root)
# Same variables as .env.production.example; only the differences are listed here. Anything not
# listed has the same meaning (copy the rest from .env.production.example, with STAGING values).
# NEVER commit the real file.

STACK=staging
# Staging on the same server as production: NO COMPOSE_PROFILES here. The production caddy serves
# this stack through the karyakita-edge network (deploy/caddy/staging.caddy.example).
# Staging on its own server: set COMPOSE_PROFILES=edge so it runs its own caddy.
COMPOSE_PROFILES=
DOMAIN=staging.karyakita.example.com
ACME_EMAIL=ops@example.com

# Different password from production; the staging DB is a separate volume.
POSTGRES_PASSWORD=

APP_ENV=production
# Seed the demo catalog + demo accounts (admin / raka / demo) into the empty staging DB.
# DEMO_PASSWORD is required with SEED_DEMO=true and must not be the dev default.
SEED_DEMO=true
DEMO_PASSWORD=
TRUSTED_PROXY_HOPS=2
ADMIN_NOTIFY_EMAIL=

# Midtrans SANDBOX keys (dashboard.sandbox.midtrans.com). Notification URL for the sandbox dashboard:
# https://staging.karyakita.example.com/api/payments/midtrans/notification
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=sandbox

# Biteship TEST key.
BITESHIP_API_KEY=

# Email capture: use a sandbox SMTP (Mailtrap sandbox, Resend test domain, ...) so staging never
# mails real customers.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=KaryaKita Staging <no-reply@staging.karyakita.example.com>

# Own bucket (or at least own keys) for uploads; backups go to <BACKUP_BUCKET>/staging.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=karyakita-files-staging
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
FILES_PUBLIC_URL=
FILES_ORIGIN=

BACKUP_BUCKET=karyakita-backups
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Google login is usually left empty on staging (it needs its own redirect URI), as is Sentry.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SENTRY_DSN=
