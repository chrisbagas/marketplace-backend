# Production environment for deploy/compose.prod.yml.
# On the server: cp deploy/.env.production.example .env.production   (in the backend repo root)
#                chmod 600 .env.production
# NEVER commit the real file (gitignored). Values marked [SECRET] must not leave the server /
# your password manager. Compose reads this file with `--env-file`; only the variables that
# compose.prod.yml names reach the containers.
#
# No spaces around "=", no quotes needed (a value containing " # " needs quotes).

# ---------------------------------------------------------------- stack / edge
# "prod" or "staging": names the web container on the shared edge network.
STACK=prod
# Start caddy (ports 80/443) in this stack. Production: edge. Staging on the SAME server: leave empty.
COMPOSE_PROFILES=edge
# Public hostname, DNS A record -> server IP. Caddy fetches a Let's Encrypt certificate for it.
# Derived from it: APP_URL, SITE_URL, GOOGLE_REDIRECT_URL (https://DOMAIN/api/auth/google/callback).
DOMAIN=karyakita.example.com
# Expiry notices from Let's Encrypt go here.
ACME_EMAIL=ops@example.com
# Where the frontend repo is checked out, relative to deploy/ (default: ../../frontend).
# FRONTEND_DIR=../../frontend

# ---------------------------------------------------------------- database
# [SECRET] Letters/digits only (it is embedded in a URL): openssl rand -hex 24
# Set it BEFORE the first `up`: Postgres only reads it when the volume is first created.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- API core
# production = Secure cookies, no demo passwords, SMTP/Midtrans misconfiguration is loud.
APP_ENV=production
# Proxy hops in front of the API: caddy -> next -> api = 2. Verify once after the first deploy
# (README, "Client IP check"): a wrong value lets clients spoof their IP in the rate limiter.
TRUSTED_PROXY_HOPS=2
# Where admin notifications (new design to review, payout request, complaint, ...) are mailed.
ADMIN_NOTIFY_EMAIL=

# ---------------------------------------------------------------- email (SMTP provider)
# Resend: smtp.resend.com / 465 / user "resend" / password = API key.  Brevo: smtp-relay.brevo.com / 587.
# SPF + DKIM + DMARC DNS records are mandatory, see deploy/README.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# [SECRET]
SMTP_PASSWORD=
# The sender domain must be the one you set up SPF/DKIM for.
MAIL_FROM=KaryaKita <no-reply@karyakita.example.com>

# ---------------------------------------------------------------- payments (Midtrans)
# production keys + MIDTRANS_ENV=production on the live site; sandbox keys + sandbox on staging.
# The API refuses to start when Midtrans rejects the keys for the chosen environment.
# Notification URL (set in the Midtrans dashboard): https://DOMAIN/api/payments/midtrans/notification
# [SECRET]
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=production
# Optional: restrict Snap channels, e.g. qris,bca_va,bni_va,bri_va,gopay
MIDTRANS_ENABLED_PAYMENTS=

# ---------------------------------------------------------------- Google login (optional)
# Authorized redirect URI in Google Cloud Console must equal https://DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
# [SECRET]
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- shipping (Biteship)
# [SECRET] live key on production, test key on staging.
BITESHIP_API_KEY=

# ---------------------------------------------------------------- uploads (S3-compatible, Cloudflare R2)
# Separate bucket from the backups. Public read via a custom domain or r2.dev URL.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=karyakita-files
S3_ACCESS_KEY_ID=
# [SECRET]
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket, e.g. https://files.karyakita.example.com
FILES_PUBLIC_URL=
# Origin of FILES_PUBLIC_URL (scheme + host, no path): allowed in the CSP img-src.
# Used at frontend BUILD time: changing it needs `up -d --build`.
FILES_ORIGIN=

# ---------------------------------------------------------------- error tracking (optional)
# Empty = disabled.
SENTRY_DSN=

# ---------------------------------------------------------------- backups (nightly pg_dump)
# Private bucket, separate from the uploads bucket. Create an R2 API token limited to it
# (Object Read & Write). Dumps land in <bucket>/<STACK>/daily and /weekly.
BACKUP_BUCKET=karyakita-backups
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_ACCESS_KEY_ID=
# [SECRET]
BACKUP_S3_SECRET_ACCESS_KEY=
# Hour (UTC) of the nightly run; 19 = 02:00 WIB.
BACKUP_HOUR_UTC=19
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# Optional dead-man's switch (healthchecks.io style URL): pinged after each good run,
# <url>/fail after a bad one; alerts you when the pings stop.
BACKUP_PING_URL=
# Tests only: BACKUP_REMOTE=/backups writes to a local volume instead of S3 (see README).
# BACKUP_REMOTE=
