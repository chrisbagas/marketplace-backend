# Salin ke .env bila perlu menimpa nilai default.
DATABASE_URL=postgres://karyakita:karyakita_dev@localhost:5432/karyakita
PORT=8081

# Penyimpanan file (S3-compatible): Cloudflare R2 di produksi, server S3 dari docker-compose di dev.
# Di luar produksi, variabel yang kosong memakai default compose (localhost:9000, bucket karyakita-files).
# Di produksi SEMUA wajib (kosong semua = unggah dinonaktifkan):
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=karyakita-files
#   S3_ACCESS_KEY_ID=...        (R2 → Manage API tokens → S3 credentials, izin Object Read & Write)
#   S3_SECRET_ACCESS_KEY=...
#   FILES_PUBLIC_URL=https://files.<domain>   (domain publik bucket; URL ini disimpan di database)
# Bucket perlu CORS: izinkan PUT dari origin situs dengan header Content-Type.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=karyakita-files
S3_ACCESS_KEY_ID=karyakita
S3_SECRET_ACCESS_KEY=karyakita_dev
FILES_PUBLIC_URL=http://localhost:9000/karyakita-files

# production = cookie Secure + akun demo TIDAK diberi password
APP_ENV=development
# password akun demo admin / raka / demo (hanya di luar produksi)
DEMO_PASSWORD=karyakita123
# paksa cookie Secure tanpa APP_ENV=production (mis. dev di balik HTTPS)
COOKIE_SECURE=false

# URL frontend — dipakai untuk link di email (verifikasi, reset password)
APP_URL=http://localhost:3000

# Salin file ini jadi backend/.env — dimuat otomatis saat API start (variabel yang
# sudah di-set di environment tidak ditimpa). .env sudah di-gitignore.

# Email lewat SMTP. Di dev, kosongkan SMTP_HOST → otomatis ke Mailpit
# (localhost:1025, kotak masuk http://localhost:8025, lihat docker-compose.yml).
# Produksi: SMTP penyedia, mis. Resend (smtp.resend.com:465, user "resend",
# password = API key), Brevo (smtp-relay.brevo.com:587), atau AWS SES.
#
# Coba kirim ke Gmail sungguhan (batas ±500 email/hari, cukup untuk uji coba):
#   1. Akun Google → Keamanan → aktifkan Verifikasi 2 Langkah
#   2. https://myaccount.google.com/apppasswords → buat "App password" (16 karakter)
#   3. isi di bawah; MAIL_FROM harus alamat Gmail yang sama (Gmail menimpa pengirim lain)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=namakamu@gmail.com
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# MAIL_FROM=KaryaKita <namakamu@gmail.com>
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=KaryaKita <no-reply@karyakita.id>

# Pembayaran — Midtrans Snap. Kosongkan MIDTRANS_SERVER_KEY untuk pembayaran TIRUAN (mock) di dev.
#   1. Daftar gratis di https://dashboard.sandbox.midtrans.com
#   2. Pastikan mode SANDBOX (toggle di dashboard), lalu Settings → Access Keys → salin Client Key & Server Key
#      (API memeriksa kunci ke Midtrans saat start; kunci yang ditolak membuat API berhenti)
#   3. Settings → Snap Preferences / Payment: aktifkan QRIS & Virtual Account; matikan kanal yang tak perlu
#   4. (Opsional, untuk webhook) Settings → Payment → Notification URL:
#        https://<tunnel-publik>/api/payments/midtrans/notification
#      Tanpa tunnel pun jalan: server mengecek status ke Midtrans sendiri setelah popup ditutup
#      dan saat halaman pesanan dibuka.
# Produksi: MIDTRANS_ENV=production + kunci produksi (Mid-server-...). Jangan commit kunci ke git.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=sandbox
# Opsional: batasi & urutkan kanal Snap (nama kanal Midtrans), mis. qris,bca_va,bni_va,bri_va,gopay
MIDTRANS_ENABLED_PAYMENTS=

# Login Google — kosongkan untuk menonaktifkan (tombol Google tampil "segera hadir").
# Buat OAuth Client ID tipe "Web application" di Google Cloud Console → Credentials,
# lalu daftarkan Authorized redirect URI yang sama persis dengan GOOGLE_REDIRECT_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback
