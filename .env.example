# Salin ke .env bila perlu menimpa nilai default.
DATABASE_URL=postgres://karyakita:karyakita_dev@localhost:5432/karyakita
PORT=8081
UPLOAD_DIR=uploads

# production = cookie Secure + akun demo TIDAK diberi password
APP_ENV=development
# password akun demo admin / raka / demo (hanya di luar produksi)
DEMO_PASSWORD=karyakita123
# paksa cookie Secure tanpa APP_ENV=production (mis. dev di balik HTTPS)
COOKIE_SECURE=false

# Login Google — kosongkan untuk menonaktifkan (tombol Google tampil "segera hadir").
# Buat OAuth Client ID tipe "Web application" di Google Cloud Console → Credentials,
# lalu daftarkan Authorized redirect URI yang sama persis dengan GOOGLE_REDIRECT_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback
